# Copy to .env and adjust. Never commit a real .env.

DATABASE_URL=postgresql+psycopg://reel_memory:changeme@localhost:5432/reel_memory
EMBEDDING_DIM=1536
WORKER_POLL_INTERVAL_S=5
WORKER_STUCK_AFTER_S=3600
WORKER_REAP_INTERVAL_S=300
MAX_ATTEMPTS=3
TEMP_DIR=/tmp/reel-memory
LOCAL_USER_EMAIL=local@reel-memory
LOG_LEVEL=INFO
PROCESSING_VERSION=v0.1.0

# --- AI providers (Milestone 4) -------------------------------------------
# "none" = loud stub that fails fast at runtime (never a silent no-op).
# "openai" = OpenAI-compatible HTTP API (stdlib urllib client, no new deps).
#   Requires OPENAI_API_KEY. OPENAI_BASE_URL lets you point at any
#   OpenAI-compatible endpoint (local gateway, proxy, other vendor).
# "hash" (embeddings only) = deterministic keyless n-gram hashing embedding.
#   Offline-safe; lexical, NOT semantic — label any benchmark that uses it.
# "deterministic" (memory generator only) = rule-based builder, no AI spend.

SPEECH_PROVIDER=none          # none | openai
VISION_PROVIDER=none          # none | openai
OCR_PROVIDER=none             # none | openai
EMBEDDING_PROVIDER=none       # none | openai | hash
MEMORY_GENERATOR_PROVIDER=deterministic  # deterministic | openai | none

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
PROVIDER_TIMEOUT_S=120
VISION_MAX_FRAMES=6

# --- Conversational Q&A + verification --------------------------------------
# CHAT_PROVIDER=openai powers POST /v1/memories/{id}/ask (needs OPENAI_API_KEY).
CHAT_PROVIDER=none            # none | openai

# SEARCH_PROVIDER=tavily powers ask with {"verify": true}: cross-checks the
# answer's factual claims against the web (Tavily-compatible /search API,
# stdlib urllib client, no new deps). Without SEARCH_API_KEY, verify mode
# returns status "unavailable" — verification is never faked.
SEARCH_PROVIDER=none          # none | tavily
SEARCH_API_KEY=
TAVILY_API_URL=https://api.tavily.com

# --- Direct video uploads ("see the reel" path) ------------------------------
# POST /v1/captures/upload stores video/* uploads as untrusted input under
# UPLOAD_DIR (default <TEMP_DIR>/uploads, never served over HTTP), dedupes by
# sha256 content hash, and feeds the normal worker pipeline. The worker
# deletes the file once the job reaches a terminal state (PRD §8.6).
# UPLOAD_DIR=/tmp/reel-memory/uploads
MAX_UPLOAD_MB=200

# --- Album/carousel capture (POST /v1/captures/album) ------------------------
# One share of 2-30 photos (at most one video) becomes ONE memory. An album
# counts as ONE capture against the free-tier quota; the caps below bound
# processing. Dedup is by the combined content hash (order-independent).
# MIN_ALBUM_FILES=2
# MAX_ALBUM_FILES=30
# MAX_ALBUM_MB=400

# --- Media decoding (Milestone 3: ffmpeg) -------------------------------------
# Video uploads and album videos are decoded locally: audio -> 16 kHz mono WAV
# for transcription, frames -> JPEGs for vision/OCR. ffmpeg + ffprobe must be
# installed (see README "Media decoding" for install commands); without them,
# video jobs fail honestly with MEDIA_DECODE_FAILED — success is never faked.
# Image uploads and article ingestion work without ffmpeg.
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# MEDIA_FRAME_COUNT=12          # JPEG frames sampled evenly per video
# MEDIA_MAX_DIMENSION_PX=1280   # frames scaled down to this width (vision cost)
# MAX_MEDIA_DURATION_S=600      # longer videos fail honestly (not truncated)
# MEDIA_PROBE_TIMEOUT_S=15
# MEDIA_DECODE_TIMEOUT_S=180

# --- Website ingestion (POST /v1/captures/url, platform "web") ----------------
# SSRF-safe fetch: https only, public IPs only, redirect limit, byte cap.
MAX_FETCH_MB=2
FETCH_TIMEOUT_S=10
FETCH_MAX_REDIRECTS=5
FETCH_USER_AGENT=ReelMemory/1.0 (+website-ingest)

# --- Estimated cost per 60s reel (defaults above, ~Sep 2026 list pricing) ---
# whisper-1 transcription:            ~$0.0060  ($0.006/min)
# gpt-4o-mini vision (6 frames):       ~$0.0010  (~1.1k img tokens/frame @ $0.15/1M in)
# gpt-4o-mini OCR pass (6 frames):     ~$0.0010
# text-embedding-3-small (~2k tokens): ~$0.00004 ($0.02/1M tokens)
# gpt-4o-mini memory gen (~4k tokens): ~$0.0008
# TOTAL ≈ $0.009/reel — under the PRD $0.02/Reel target.
# Longer reels scale mostly with whisper ($0.006/min) + vision frames.

# --- Auth (commercialization track) ------------------------------------------
# JWT_SECRET is REQUIRED for /v1/auth/* — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Without it, auth endpoints fail fast (never a weak default).
JWT_SECRET=<redacted>
JWT_ACCESS_TTL_S=900
JWT_REFRESH_TTL_S=2592000
# Google Sign-In: the OAuth client ID for the app (Google Cloud Console ->
# APIs & Services -> Credentials). Unset -> /v1/auth/google returns 503.
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>
# Login brute-force protection (per process; see README for multi-worker note).
LOGIN_MAX_ATTEMPTS_IP=20
LOGIN_MAX_ATTEMPTS_ACCOUNT=8
LOGIN_WINDOW_S=600
# Throwaway local dev only: seeds LOCAL_USER_EMAIL on boot so the API works
# without signup. NEVER enable in production.
DEV_SEED_LOCAL_USER=false

# --- Freemium entitlements ----------------------------------------------------
# Free tier: 20 captures/month, 50 questions/day, 10 verifications/day.
# Pro: these limits x PRO_QUOTA_MULTIPLIER (abuse caps, not infinite).
FREE_CAPTURES_MONTHLY=20
FREE_QUESTIONS_DAILY=50
FREE_VERIFICATIONS_DAILY=10
PRO_QUOTA_MULTIPLIER=10

# --- Google Play Billing ------------------------------------------------------
# Service-account JSON for the Play Developer API (inline JSON or a file path).
# Unset -> POST /v1/billing/verify returns 503 billing_not_configured.
# See README "Selling Pro with Google Play" for the full publisher setup.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=<inline-json-or-/path/to/service-account.json>

# --- Visual search (find reels by what was SEEN) ------------------------------
# One-time, at ingest: representative frames (12 uniform + up to 12
# scene-cut extras, <= ~24 total) are embedded LOCALLY with a joint
# image/text model and stored in memory_frame_embeddings. Search embeds the
# text query with the same model and matches stored frames — no video
# decoding, no vision API call, $0 cost at search time.
# "none" (default) = visual indexing skipped (existing behavior unchanged).
# "openclip" = local OpenCLIP model; needs `pip install -e ".[visual]"` and
#   ffmpeg/ffprobe (already required). First ingest/search after deploy
#   downloads the weights once (~578MB for the default) into
#   VISUAL_MODEL_CACHE_DIR (default: HuggingFace cache ~/.cache/huggingface).
VISUAL_EMBEDDING_PROVIDER=none   # none | openclip
VISUAL_EMBEDDING_MODEL=ViT-B-32
VISUAL_EMBEDDING_PRETRAINED=laion2b_s34b_b79k
# Must match the model AND the memory_frame_embeddings.embedding vector(N)
# column (migration 005). Changing to a model with a different dim needs a
# re-migration + full visual re-index; the worker fails fast on mismatch.
VISUAL_EMBEDDING_DIM=512
VISUAL_MAX_EXTRA_FRAMES=12
VISUAL_SCENE_THRESHOLD=0.10
# VISUAL_MODEL_CACHE_DIR=/var/lib/reel-memory/models
VISUAL_EMBED_BATCH_SIZE=16
